{
  "name": "buntpapier",
  "version": "3.0.0-alpha.18",
  "description": "",
  "author": "rashfael <rashfael@isobeef.org>",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "playwright test",
    "test:docs": "playwright test --config=playwright.docs.config.ts",
    "test:report": "playwright show-report",
    "build": "vite build",
    "build:docs": "vitepress build docs",
    "start": "vitepress dev docs",
    "deploy": "npm run build:docs -s && gh-pages -d docs/.vitepress/dist -r git@github.com:rashfael/buntpapier-v3-docs.git",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue-macros/reactivity-transform": "^3.1.4",
    "@vue/language-plugin-pug": "^3.3.11",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vue-pug": "^1.0.0-alpha.6",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "pug": "^3.0.4",
    "sass": "^1.104.1",
    "stylus": "^0.64.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitepress": "^2.0.0-alpha.20",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/buntpapier.umd.cjs",
  "module": "./dist/buntpapier.js",
  "exports": {
    ".": {
      "import": "./dist/buntpapier.js",
      "require": "./dist/buntpapier.umd.cjs"
    },
    "./style": {
      "import": "./dist/buntpapier.css",
      "require": "./dist/buntpapier.css"
    }
  },
  "repository": {
    "url": "git+https://github.com/rashfael/buntpapier.git"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@popperjs/core": "^2.11.8",
    "color": "^5.0.3",
    "color-blend": "^4.0.0"
  }
}
